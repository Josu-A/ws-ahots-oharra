<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="author" content="Josu Aguinaga">
    <meta name="description" content="Ahots Oharrak WS ikasgairako">
    <link rel="icon" href="favicon.ico" type="image/x-icon">
    <title>Login - Ahots oharrak</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/login.css">
    <script src="/js/loginValidation.js" defer></script>
    <script src="/utils/moment/moment.js"></script>
    <script src="/utils/moment/eu.js"></script>
    <link rel="stylesheet" href="/utils/snackbar/snackbar.min.css">
    <script src="/utils/snackbar/snackbar.min.js"></script>
</head>
<body>
    <div id="container">
        <header>
            <h1><a href="/">Ahots <span style="color: deeppink">oharrak</span></a></h1>
        </header>
        <main>
            <section class="oauth-login">
                <div class="text-center text-small">Sartu zerbitzari batekin</div>
                <div id="login-oauth-container">
                    <div class="oauth-option google">
                        <a href="/auth/google">
                            <img src="/images/google_logo.png">
                        </a>
                    </div>
                    <div class="oauth-option github">
                        <a href="/auth/github">
                            <img src="/images/github_logo.png">
                        </a>
                    </div>
                </div>
            </section>
            <section class="standard-login">
                <div class="text-center text-small">edo</div>
                <form id="login-form" method="post">
                    <div class="login-container">
                        <div class="lh-0">
                            <input type="text" name="username" id="username" placeholder="Erabiltzaile izena" required>
                        </div>
                        <div class="lh-0">
                            <input type="password" name="password" id="password" placeholder="Pasahitza" required>
                        </div>
                    </div>
                    <div class="login-buttons">
                        <div>
                            <a class="link" href="register">Konturik ez?</a>
                        </div>
                        <button name="submit" type="submit">Sartu</button>
                    </div>
                </form>
            </section>
        </main>
        <footer>
            <p>Web Sistemak (2023-2024)</p>
        </footer>
    </div>
</body>
</html>
