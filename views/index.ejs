<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="author" content="Josu Aguinaga">
    <meta name="description" content="Ahots Oharrak WS ikasgairako">
    <link rel="icon" href="favicon.ico" type="image/x-icon">
    <title>Ahots oharrak</title>
    <link rel="stylesheet" href="/css/style.css">
    <script src="/utils/moment/moment.js"></script>
    <script src="/utils/moment/eu.js"></script>
    <link rel="stylesheet" href="/utils/snackbar/snackbar.min.css">
    <script src="/utils/snackbar/snackbar.min.js"></script>
    <script type="module" src="/js/main.js" defer></script>
</head>
<body>
    <% if (!logged) { %>
    <nav class="banner-login">
        <a class="link login" href="/login">Sartu</a>
        <a class="link register" href="/register">Izena eman</a>
    </nav>
    <% } else { %>
    <nav class="banner-login logged">
        <span>Saioa hasita <span class="username"><%= logged %></span> gisa</span>
        <a class="link logout" href="/logout">Irten</a>
    </nav>
    <% } %>
    <div id="container">
        <header>
            <h1><a href="/">Ahots <span style="color: deeppink">oharrak</span></a></h1>
        </header>
        <main>
            <section class="ahots-buttons">
                <div id="record-button"></div>
                <div id="play-button"></div>
                <div id="upload-button"></div>
            </section>
        </main>
        <% include footer.ejs %>
    </div>
</body>
</html>
